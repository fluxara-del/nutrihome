# Local development only. Copy to .env; do not commit .env.
DATABASE_URL=file:./data/nutrihome.db
APP_URL=http://localhost:3000
TZ=Europe/Zagreb
# Optional, server-only USDA FoodData Central key. Leave empty to use local/OFF.
# Never prefix this with NEXT_PUBLIC_ or commit a real key.
USDA_API_KEY=
# Owner creation reads NUTRIHOME_ADMIN_PASSWORD only for the CLI invocation.
# No password, API key, or session signing secret is required at application startup.
