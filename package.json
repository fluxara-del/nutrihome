{
  "name": "nutrihome",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/test-e2e.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/prepare-db.ts && prisma migrate deploy && tsx scripts/import-reference.ts --if-empty",
    "db:seed": "tsx prisma/seed.ts",
    "owner:create": "tsx scripts/create-owner.ts",
    "backup": "tsx scripts/backup.ts",
    "docker:smoke": "bash scripts/docker-smoke.sh",
    "catalog:prepare": "node scripts/prepare-reference.mjs",
    "catalog:import": "tsx scripts/import-reference.ts",
    "qa:performance": "tsx scripts/qa-performance.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/hrv": "1.0.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.9",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "7.0.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
